{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal Tauri API permissions for trusted pude application windows",
  "windows": ["main", "pude-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-set-title",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "allow-startup-folder",
    "allow-open-folder-dialog",
    "allow-open-file-dialog",
    "allow-save-file-dialog",
    "allow-open-new-window",
    "allow-list-directory",
    "allow-read-file",
    "allow-read-workspace-image",
    "allow-path-exists",
    "allow-stat-files",
    "allow-save-file",
    "allow-save-file-as",
    "allow-inspect-save-as-destination",
    "allow-create-file",
    "allow-create-directory",
    "allow-rename-path",
    "allow-delete-path",
    "allow-git-status",
    "allow-git-branches",
    "allow-git-commits",
    "allow-cancel-workspace",
    "allow-git-operation",
    "allow-create-git-worktree",
    "allow-git-diff",
    "allow-git-commit-diff",
    "allow-git-commit-files",
    "allow-watch-workspace",
    "allow-stop-watcher",
    "allow-terminal-start",
    "allow-terminal-write",
    "allow-terminal-kill",
    "allow-terminal-resize",
    "allow-terminal-ack-output",
    "allow-reveal-in-file-manager",
    "allow-open-release-page",
    "allow-inspect-plugin-dialog",
    "allow-commit-plugin-install",
    "allow-cancel-plugin-install",
    "allow-rollback-plugin-update",
    "allow-uninstall-plugin",
    "allow-retry-plugin-cleanup",
    "allow-recover-plugin-updates",
    "allow-read-plugin-entry",
    "allow-plugin-network-authorize",
    "allow-plugin-network-request",
    "allow-plugin-network-revoke",
    "allow-plugin-network-cancel",
    "allow-plugin-workspace-canonicalize",
    "allow-plugin-git-diff",
    "allow-plugin-workspace-list",
    "allow-plugin-workspace-read-file",
    "allow-plugin-workspace-write-file",
    "allow-lsp-resolve-server",
    "allow-lsp-approve-server",
    "allow-lsp-revoke-server",
    "allow-lsp-start-server",
    "allow-lsp-send-message",
    "allow-lsp-cancel-request",
    "allow-lsp-stop-server",
    "allow-lsp-stop-workspace",
    "allow-lsp-stop-plugin",
    "allow-mark-window-shown",
    "allow-log-frontend-error",
    "allow-get-startup-timing",
    "allow-report-startup-event",
    "allow-app-quit-events-ready",
    "allow-app-quit-prepare-reply",
    "allow-app-quit-commit-ready"
  ]
}
